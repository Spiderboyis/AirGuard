# AirGuard backend configuration.
#
# Settings are read from `.env` and then `.env.local` (later wins). Put personal keys in
# `.env.local`; both files are git-ignored. Only OPENAQ_API_KEY is strictly required.

# --- Database --------------------------------------------------------------------------------
# Local Supabase (started with `make db-start`). For a hosted project use its connection string
# (Project Settings -> Database -> Connection string, "Session pooler").
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Air quality and fire data ---------------------------------------------------------------
# https://explore.openaq.org/register  (free)
OPENAQ_API_KEY=
# https://firms.modaps.eosdis.nasa.gov/api/map_key/  (free, optional)
FIRMS_MAP_KEY=

# --- Routing and geocoding (keyless public services by default) ------------------------------
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://routing.openstreetmap.de
# Optional: OpenRouteService instead of OSRM (set ROUTING_PROVIDER=ors)
ORS_API_KEY=
GEOCODER_URL=https://photon.komoot.io
# Optional contact address sent in the User-Agent to public APIs.
CONTACT_EMAIL=

# --- Forecast model --------------------------------------------------------------------------
MODEL_DIR=backend/models
# Empty = newest trained model in MODEL_DIR.
MODEL_VERSION=

# --- Agent / LLM -----------------------------------------------------------------------------
# ollama (local, default) | bedrock (AWS) | none (deterministic explanations only)
LLM_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
AWS_REGION=us-east-1
AGENT_RATE_LIMIT_PER_MIN=8

# --- API -------------------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Serve forecasts from a frozen snapshot file instead of the database (demo recordings).
DEMO_SNAPSHOT=
