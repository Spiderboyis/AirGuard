{
  "openapi": "3.1.0",
  "info": {
    "title": "AirGuard API",
    "version": "0.1"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/geocode": {
      "get": {
        "summary": "Geocode",
        "operationId": "geocode_geocode_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80,
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/forecast": {
      "get": {
        "summary": "Forecast",
        "operationId": "forecast_forecast_get",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 29.0,
              "minimum": 28.2,
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 77.7,
              "minimum": 76.7,
              "title": "Lon"
            }
          },
          {
            "name": "horizon_h",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 24,
              "minimum": 0,
              "default": 1,
              "title": "Horizon H"
            }
          },
          {
            "name": "demo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Demo"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/routes/score": {
      "post": {
        "summary": "Routes Score",
        "operationId": "routes_score_routes_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/trips/analyze": {
      "post": {
        "summary": "Trips Analyze",
        "operationId": "trips_analyze_trips_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/departure/best": {
      "post": {
        "summary": "Departure Best",
        "operationId": "departure_best_departure_best_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepartureRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/config": {
      "get": {
        "summary": "Config",
        "operationId": "config_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/eval": {
      "get": {
        "summary": "Eval ",
        "operationId": "eval__eval_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/agent/chat": {
      "post": {
        "summary": "Agent Chat",
        "description": "Local chat route. Deployed API Gateway sends this path to the agent Lambda instead.",
        "operationId": "agent_chat_agent_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          },
          "profile": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Profile"
          },
          "trip_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trip Id"
          },
          "history": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "History",
            "default": []
          },
          "demo": {
            "type": "boolean",
            "title": "Demo",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "DepartureRequest": {
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/Point"
          },
          "destination": {
            "$ref": "#/components/schemas/Point"
          },
          "mode": {
            "type": "string",
            "enum": [
              "walk",
              "cycle",
              "car"
            ],
            "title": "Mode",
            "default": "walk"
          },
          "window_h": {
            "type": "number",
            "maximum": 6.0,
            "exclusiveMinimum": 0.0,
            "title": "Window H",
            "default": 4.0
          },
          "max_wait_min": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 0.0,
            "title": "Max Wait Min",
            "default": 120
          },
          "max_extra_min": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Max Extra Min",
            "default": 15
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "normal",
              "sensitive",
              "high"
            ],
            "title": "Sensitivity",
            "default": "normal"
          },
          "demo": {
            "type": "boolean",
            "title": "Demo",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "origin",
          "destination"
        ],
        "title": "DepartureRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Point": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 29.0,
            "minimum": 28.2,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 77.7,
            "minimum": 76.7,
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "Point"
      },
      "RouteOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "duration_min": {
            "type": "number",
            "title": "Duration Min"
          },
          "distance_km": {
            "type": "number",
            "title": "Distance Km"
          },
          "exposure_index": {
            "type": "number",
            "title": "Exposure Index"
          },
          "mean_pm25": {
            "type": "number",
            "title": "Mean Pm25"
          },
          "risk": {
            "type": "string",
            "title": "Risk"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "type": "array",
            "title": "Segments"
          },
          "geometry": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Geometry"
          },
          "is_cleanest": {
            "type": "boolean",
            "title": "Is Cleanest"
          },
          "is_fastest": {
            "type": "boolean",
            "title": "Is Fastest"
          }
        },
        "type": "object",
        "required": [
          "id",
          "duration_min",
          "distance_km",
          "exposure_index",
          "mean_pm25",
          "risk",
          "confidence",
          "segments",
          "geometry",
          "is_cleanest",
          "is_fastest"
        ],
        "title": "RouteOut"
      },
      "Segment": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          },
          "pm25": {
            "type": "number",
            "title": "Pm25"
          },
          "minutes": {
            "type": "number",
            "title": "Minutes"
          },
          "line": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Line"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon",
          "pm25",
          "minutes",
          "line"
        ],
        "title": "Segment"
      },
      "TripRequest": {
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/Point"
          },
          "destination": {
            "$ref": "#/components/schemas/Point"
          },
          "mode": {
            "type": "string",
            "enum": [
              "walk",
              "cycle",
              "car"
            ],
            "title": "Mode",
            "default": "walk"
          },
          "window_h": {
            "type": "number",
            "maximum": 6.0,
            "exclusiveMinimum": 0.0,
            "title": "Window H",
            "default": 4.0
          },
          "max_extra_min": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Max Extra Min",
            "default": 15
          },
          "max_wait_min": {
            "type": "integer",
            "maximum": 720.0,
            "minimum": 0.0,
            "title": "Max Wait Min",
            "default": 120
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "normal",
              "sensitive",
              "high"
            ],
            "title": "Sensitivity",
            "default": "normal"
          },
          "demo": {
            "type": "boolean",
            "title": "Demo",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "origin",
          "destination"
        ],
        "title": "TripRequest"
      },
      "TripResponse": {
        "properties": {
          "routes": {
            "items": {
              "$ref": "#/components/schemas/RouteOut"
            },
            "type": "array",
            "title": "Routes"
          },
          "data_age_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Age Min"
          },
          "mode_factor": {
            "type": "number",
            "title": "Mode Factor"
          }
        },
        "type": "object",
        "required": [
          "routes",
          "data_age_min",
          "mode_factor"
        ],
        "title": "TripResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}